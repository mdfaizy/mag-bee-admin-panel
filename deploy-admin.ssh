#!/bin/bash

BRANCH=$1

if [ -z "$BRANCH" ]; then
  echo "❌ Please provide branch name"
  exit 1
fi

echo "🚀 Deploying Next.js Admin Panel Branch: $BRANCH"

ssh root@195.250.30.134 << ENDSSH

cd /var/www/magbeeadmin.magaritatech.com

git checkout $BRANCH
git pull origin $BRANCH

npm install
npm run build

pm2 restart magbee-admin-panel

ENDSSH

echo "✅ Deployment Done!"